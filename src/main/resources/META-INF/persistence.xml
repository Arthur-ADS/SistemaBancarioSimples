<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="banco_pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades mapeadas (Endereco é @Embeddable e entra junto com Cliente) -->
        <class>banco.modelo.Cliente</class>
        <class>banco.modelo.Conta</class>
        <class>banco.modelo.ContaCorrente</class>
        <class>banco.modelo.ContaPoupanca</class>
        <class>banco.modelo.Movimentacao</class>
        <class>banco.modelo.Servico</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- createDatabaseIfNotExist: o MySQL cria o banco na primeira execução -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/banco_poo_jpa?createDatabaseIfNotExist=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="********!"/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!-- Gera/atualiza as tabelas automaticamente e mostra o SQL (fins didáticos) -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
